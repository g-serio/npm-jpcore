{
  "name": "@olonjs/react",
  "version": "0.1.10",
  "private": false,
  "type": "module",
  "main": "./dist/olonjs-react.umd.cjs",
  "module": "./dist/olonjs-react.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/olonjs-react.js",
      "require": "./dist/olonjs-react.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "description": "React rendering bindings for the OlonJS engine (JsonPagesEngine, PageRenderer, ConfigContext). Depends on @olonjs/core; dynamically loads the optional @olonjs/studio editor for the /admin route.",
  "author": "JsonPages Team",
  "license": "MIT",
  "homepage": "https://github.com/olonjs/npm-jpcore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olonjs/npm-jpcore.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/olonjs/npm-jpcore/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "node scripts/sync-peers-from-stack.js",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.29.0",
    "@olonjs/studio": "^0.1.10"
  },
  "peerDependenciesMeta": {
    "@olonjs/studio": {
      "optional": true
    }
  },
  "dependencies": {
    "@olonjs/core": "^1.1.27",
    "lucide-react": "^0.474.0"
  },
  "devDependencies": {
    "@olonjs/stack": "^1.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
