{
  "name": "@olonjs/core",
  "version": "1.1.30",
  "private": false,
  "type": "module",
  "main": "./dist/olonjs-core.umd.cjs",
  "module": "./dist/olonjs-core.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/olonjs-core.js",
      "require": "./dist/olonjs-core.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "description": "The framework-agnostic Sovereign Core Engine for OlonJS: protocol types, config/collection resolution, theme-token logic, WebMCP contracts, and routing helpers. Zero React dependency — consumed by @olonjs/react and @olonjs/studio.",
  "author": "JsonPages Team",
  "license": "MIT",
  "homepage": "https://github.com/olonjs/npm-jpcore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olonjs/npm-jpcore.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/olonjs/npm-jpcore/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "node scripts/sync-peers-from-stack.js",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^3.24.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@olonjs/stack": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
