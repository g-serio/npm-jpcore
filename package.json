{
    "name": "olonjs-monorepo",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev -w tenant-alpha",
        "dev:landing": "npm run dev -w olonjs-landing",
        "build": "npm run build -w tenant-alpha",
        "build:landing": "npm run build -w olonjs-landing",
        "build:all": "npm run build --workspaces --if-present",
        "release": "node scripts/release.js",
        "check:templates": "node scripts/check-cli-templates.mjs",
        "test:boundary": "node scripts/check-package-boundaries.mjs",
        "dist:dna:all": "npm run dist -w tenant-alpha && npm run dist -w tenant-next",
        "release:enterprise": "node scripts/release-enterprise.js",
        "bump:all": "tsx scripts/bump-schemas.ts"
    },
    "devDependencies": {
        "ajv": "^8.17.1",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "zod-to-json-schema": "^3.24.1"
    },
    "version": "0.0.64"
}
